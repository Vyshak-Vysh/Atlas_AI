# Dedicated embedder microservice image — the only image in this repo that
# carries torch/sentence-transformers (see the implementation plan's
# "Serving topology decision": one warm process, not loaded per worker).
# Build context is the repo root (see docker-compose.yml).
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.11.4 /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/domain/pyproject.toml packages/domain/pyproject.toml
COPY packages/db/pyproject.toml packages/db/pyproject.toml
COPY packages/retrieval/pyproject.toml packages/retrieval/pyproject.toml
COPY packages/connectors/pyproject.toml packages/connectors/pyproject.toml
COPY packages/llm_gateway/pyproject.toml packages/llm_gateway/pyproject.toml
COPY packages/evaluation/pyproject.toml packages/evaluation/pyproject.toml
COPY packages/security/pyproject.toml packages/security/pyproject.toml
COPY apps/ai_atlas/pyproject.toml apps/ai_atlas/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml

COPY packages packages
COPY apps/ai_atlas apps/ai_atlas

RUN uv sync --frozen --package ai-atlas --extra embedder

ENV PATH="/app/.venv/bin:$PATH"
# Pre-download the model at build time so the first container start doesn't
# pay a multi-hundred-MB download against the readiness/health check.
ENV EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBEDDING_MODEL_NAME}')"

EXPOSE 8090

CMD ["uvicorn", "ai_atlas.embedder_service.main:app", "--host", "0.0.0.0", "--port", "8090"]
