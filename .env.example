# AtlasAI environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# Every value below is a placeholder — the application must fail to start
# (not silently fall back to a default) if a required secret is missing.

# --- Core -------------------------------------------------------------
ATLASAI_ENV=development
ATLASAI_LOG_LEVEL=INFO
ATLASAI_SECRET_KEY=change-me-to-a-random-64-char-value

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atlasai
POSTGRES_USER=atlasai
POSTGRES_PASSWORD=change-me
# These two are for HOST-SIDE tooling (Alembic, pytest run outside Docker).
# docker-compose.yml overrides both to postgresql://...@postgres:5432/...
# for every in-network service — see its `x-in-network-env` anchor.
# Host port defaults to 15432 (not 5432) — deliberately far from the
# standard port and from any other local project's Postgres container;
# adjust to match your docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://atlasai:change-me@localhost:15432/atlasai
DATABASE_URL_SYNC=postgresql+psycopg://atlasai:change-me@localhost:15432/atlasai

# --- Redis (Celery broker/result backend + realtime pub/sub) ----------
# Host-side value; docker-compose overrides this to redis://redis:6379/0
# for every in-network service. Host port defaults to 6380 (see docker-compose.yml).
REDIS_URL=redis://localhost:6380/0

# --- Object storage (S3-compatible / MinIO in dev) ---------------------
OBJECT_STORE_ENDPOINT_URL=http://minio:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=change-me
OBJECT_STORE_SECRET_KEY=change-me
OBJECT_STORE_BUCKET_RAW=atlasai-raw-sources
OBJECT_STORE_BUCKET_EXTRACTED=atlasai-extracted-text
OBJECT_STORE_USE_SSL=false

# --- Embedding service ---------------------------------------------------
EMBEDDER_BASE_URL=http://embedder:8090
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# --- Malware scanning (ClamAV) ------------------------------------------
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Anthropic (LLM gateway) ---------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_CLASSIFY=claude-haiku-4-5-20251001
LLM_MODEL_DEFAULT=claude-sonnet-5
LLM_MODEL_ESCALATION=claude-opus-5
LLM_MAX_TOKENS_DEFAULT=8000
LLM_PROMPT_VERSION=v1

# --- Auth / JWT -----------------------------------------------------------
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_SIGNING_KEY=change-me-to-a-random-64-char-value
JWT_ALGORITHM=HS256

# --- Credential-ref envelope encryption (packages/security) -------------
CREDENTIAL_ENCRYPTION_KEY=

# --- Agent run limits -----------------------------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_CALLS_PER_TOOL=3
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TOKEN_BUDGET=200000

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_VECTOR_INDEX_ENABLED=false
RETRIEVAL_TOP_K=40
RETRIEVAL_RERANK_TOP_N=10

# --- Frontend / CORS --------------------------------------------------------
WEB_PUBLIC_API_BASE_URL=http://localhost:8000
API_CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Connectors: Git/CI (GitHub) — fully live ------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Connectors: Gmail — inert until configured ----------------------------
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=

# --- Connectors: Microsoft Graph — inert until configured ------------------
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=
MSGRAPH_REDIRECT_URI=

# --- Connectors: Google Drive — inert until configured ---------------------
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REDIRECT_URI=

# --- Connectors: Meetings (webhook receiver, no provider wired) ------------
MEETINGS_WEBHOOK_SIGNING_SECRET=

# --- Connectors: Project management (Jira) — inert until configured -------
JIRA_BASE_URL=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=

# --- Object retention / deletion jobs ---------------------------------------
RETENTION_TOMBSTONE_AFTER_DAYS=90
